# Firebase Configuration Example
# Copy this file to .env.local and fill in with your real Firebase project details.
# DO NOT commit .env.local to git.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_DATABASE_URL=your_database_url_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Google Cloud Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_APP_ID=your_google_project_number_here

# Firebase Cloud Function Base URL for Drive Stream Proxy
# Local Emulator example: http://localhost:5001/YOUR_PROJECT_ID/us-central1/driveStream
VITE_DRIVE_STREAM_BASE_URL=http://localhost:5001/your_firebase_project_id_here/us-central1/driveStream


